{
  "name": "nodejs-boilerplate",
  "version": "1.0.0",
  "scripts": {
    "start": "pm2 start ecosystem.config.js && pm2 log",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "rm -rf ./build && tsc",
    "lint": "eslint ./src/**/*.ts -c .eslintrc.json",
    "test": "jest",
    "up": "docker-compose up",
    "seed": "ts-node-dev --transpile-only scripts/seedMockData.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.948.0",
    "@aws-sdk/s3-request-presigner": "^3.948.0",
    "@types/morgan": "^1.9.2",
    "@types/node": "14.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cors": "^2.8.5",
    "dayjs": "^1.11.19",
    "dotenv": "^8.2.0",
    "express": "^4.17.1",
    "mongoose": "^9.0.1",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "pm2": "^4.5.6",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.34.5",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "typescript": "^4.2.4",
    "express-validator": "^7.2.1",
    "uuid": "^13.0.0",
    "winston": "^3.3.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.10",
    "@types/express": "^4.17.11",
    "@types/multer": "^2.0.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^4.22.0",
    "@typescript-eslint/parser": "^4.22.0",
    "eslint": "^7.25.0",
    "eslint-plugin-node": "^11.1.0",
    "ts-node-dev": "^1.1.8"
  }
}
